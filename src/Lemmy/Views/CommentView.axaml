<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Lemmy.ViewModels"
             xmlns:views="using:Lemmy.Views"
             xmlns:md="using:Lemmy.Views.Markdown"
             mc:Ignorable="d" d:DesignWidth="420"
             x:Class="Lemmy.Views.CommentView"
             x:DataType="vm:CommentViewModel">

    <!-- A comment draws itself, then its replies through this same control: the nesting in the
         markup mirrors the nesting in the thread. -->
    <StackPanel>

        <Border BorderBrush="{DynamicResource ThreadLineBrush}"
                BorderThickness="2,0,0,0"
                Padding="10,6,0,6">
            <StackPanel Spacing="4">

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="link"
                            FontSize="12"
                            Width="18"
                            Command="{Binding ToggleCollapsedCommand}"
                            Content="{Binding ToggleLabel}"
                            IsVisible="{Binding HasReplies}" />
                    <Button Classes="link" Padding="0" Command="{Binding OpenAuthorCommand}">
                        <TextBlock Classes="meta"
                                   Foreground="{DynamicResource AccentText}"
                                   Text="{Binding AuthorLabel}" />
                    </Button>
                    <Border Classes="chip" IsVisible="{Binding HasAuthorBadge}">
                        <TextBlock Classes="badge" Text="{Binding AuthorBadgeLabel}" />
                    </Border>
                    <views:VoteBarView DataContext="{Binding Votes}" />
                    <TextBlock Classes="meta" Text="·" />
                    <TextBlock Classes="meta" Text="{Binding AgeLabel}" />
                    <TextBlock Classes="meta"
                               IsVisible="{Binding WasEdited}"
                               ToolTip.Tip="Edited since it was posted"
                               Text="· edited" />
                </StackPanel>

                <md:MarkdownView IsVisible="{Binding !IsCollapsed}"
                                 Blocks="{Binding Content}"
                                 LinkCommand="{Binding LinkCommand}"
                                 Media="{Binding Media}" />

                <!-- Reply, and the author's own controls. Only shown unfolded: a collapsed comment
                     is one the reader has put away. -->
                <!-- Generous spacing: these sit side by side and one of them is Delete. -->
                <WrapPanel ItemSpacing="18"
                           LineSpacing="8"
                           IsVisible="{Binding !IsCollapsed}">
                    <Button Classes="link"
                            Content="Reply"
                            IsVisible="{Binding CanReply}"
                            Command="{Binding ReplyCommand}" />
                    <!-- A finger cannot select text, so copying needs something to press. -->
                    <Button Classes="link"
                            IsVisible="{Binding CanCopy}"
                            Command="{Binding CopyCommand}">
                        <TextBlock Text="{Binding WasCopied, Converter={x:Static vm:CopyLabel.Instance}}" />
                    </Button>
                    <Button Classes="link"
                            Content="Edit"
                            IsVisible="{Binding CanAmend}"
                            Command="{Binding EditCommand}" />
                    <Button Classes="link"
                            Content="Delete"
                            IsVisible="{Binding CanAmend}"
                            IsEnabled="{Binding !IsAmending}"
                            Command="{Binding ToggleDeletedCommand}" />
                    <Button Classes="link"
                            Content="Restore"
                            IsVisible="{Binding CanRestore}"
                            IsEnabled="{Binding !IsAmending}"
                            Command="{Binding ToggleDeletedCommand}" />
                </WrapPanel>

                <TextBlock Classes="meta"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource NegativeText}"
                           IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding ActionError}" />

                <StackPanel Margin="0,4,0,0"
                            IsVisible="{Binding Composer, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <views:CommentComposerView DataContext="{Binding Composer}" />
                </StackPanel>

                <TextBlock Classes="meta"
                           Foreground="{DynamicResource SecondaryText}"
                           IsVisible="{Binding HasUnloadedReplies}"
                           Text="{Binding UnloadedRepliesLabel}" />
            </StackPanel>
        </Border>

        <!-- Indentation lives here rather than in the view model: each level nests inside the one
             above it, so a fixed margin per level is all the nesting depth this needs to know. -->
        <ItemsControl Margin="12,0,0,0"
                      ItemsSource="{Binding Replies}"
                      IsVisible="{Binding !IsCollapsed}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CommentViewModel">
                    <views:CommentView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
