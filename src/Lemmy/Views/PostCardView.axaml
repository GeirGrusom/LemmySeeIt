<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Lemmy.ViewModels"
             xmlns:views="using:Lemmy.Views"
             mc:Ignorable="d" d:DesignWidth="420"
             x:Class="Lemmy.Views.PostCardView"
             x:DataType="vm:PostCardViewModel">

    <Button Classes="card" Command="{Binding OpenCommand}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

            <!-- Community, author, age. -->
            <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                <TextBlock Classes="meta" Foreground="{DynamicResource AccentText}" Text="{Binding CommunityLabel}" />
                <TextBlock Classes="meta" Text=" · " />
                <TextBlock Classes="meta" Text="{Binding AuthorLabel}" />
                <Border Classes="chip" Margin="6,0,0,0" IsVisible="{Binding HasAuthorBadge}">
                    <TextBlock Classes="badge" Text="{Binding AuthorBadgeLabel}" />
                </Border>
                <TextBlock Classes="meta" Text=" · " />
                <TextBlock Classes="meta" Text="{Binding AgeLabel}" />
                <Border Classes="chip" Margin="6,0,0,0" IsVisible="{Binding IsFeatured}">
                    <TextBlock Classes="badge" Text="PINNED" />
                </Border>
                <Border Classes="chip" Margin="6,0,0,0" IsVisible="{Binding IsNsfw}">
                    <TextBlock Classes="badge" Foreground="{DynamicResource NegativeText}" Text="NSFW" />
                </Border>
            </WrapPanel>

            <!-- Title and link host. -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,8,0" Spacing="2">
                <TextBlock Classes="title" Text="{Binding Title}" />
                <TextBlock Classes="meta"
                           IsVisible="{Binding HasLink}"
                           Foreground="{DynamicResource SecondaryText}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding LinkHostLabel}" />
            </StackPanel>

            <!-- Thumbnail, with a cover for anything flagged not safe for work. -->
            <Panel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" IsVisible="{Binding HasImage}">
                <Border Width="88" Height="88" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource AppBackground}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>

                <!-- Tapping the picture opens the picture; tapping anywhere else on the card opens
                     the post. Nested inside the card's button on purpose: the inner one wins, which
                     is what makes an art or comic feed browsable a picture at a time. -->
                <Button Classes="link"
                        IsVisible="{Binding CanViewImage}"
                        IsEnabled="{Binding !IsImageHidden}"
                        Command="{Binding ViewImageCommand}"
                        ToolTip.Tip="View image"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border Background="Transparent" CornerRadius="8" />
                </Button>

                <Button Classes="link"
                        IsVisible="{Binding IsImageHidden}"
                        Command="{Binding RevealImageCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border Background="{DynamicResource ScrimBrush}" CornerRadius="8">
                        <TextBlock Classes="badge"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="SHOW" />
                    </Border>
                </Button>
            </Panel>

            <!-- Body preview. -->
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Classes="body"
                       Margin="0,8,0,0"
                       MaxLines="3"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SecondaryText}"
                       IsVisible="{Binding HasBodyPreview}"
                       Text="{Binding BodyPreview}" />

            <!-- Counts. -->
            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
                <views:VoteBarView DataContext="{Binding Votes}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="meta" Text="&#x1F5E8;" />
                    <TextBlock Classes="meta" Text="{Binding CommentsLabel}" />
                </StackPanel>
                <TextBlock Classes="meta" IsVisible="{Binding IsLocked}" Text="&#x1F512; locked" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
