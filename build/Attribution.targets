<Project>

  <!--
    Generates the attribution list from the packages this project actually ships.

    The source is RuntimeCopyLocalItems and NativeCopyLocalItems rather than PackageReference:
    those are the assets that end up beside the binary, so the list covers transitive dependencies
    and excludes build-only tooling (ILLink, ILCompiler) and native asset packs for other
    platforms. Each package's licence, copyright and project URL are read from its .nuspec in the
    NuGet cache, so nothing here is maintained by hand.
  -->

  <UsingTask TaskName="GenerateAttribution"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Packages ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <PackageRoot ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
      <Namespace ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Xml.Linq;

public class GenerateAttribution : Microsoft.Build.Utilities.Task
{
    public Microsoft.Build.Framework.ITaskItem[] Packages { get; set; }
    public string PackageRoot { get; set; }
    public string OutputPath { get; set; }
    public string Namespace { get; set; }

    public override bool Execute()
    {
        var seen = new SortedDictionary<string, string[]>(StringComparer.OrdinalIgnoreCase);

        foreach (var item in Packages)
        {
            string id = item.GetMetadata("NuGetPackageId");
            string version = item.GetMetadata("NuGetPackageVersion");
            if (string.IsNullOrEmpty(id) || string.IsNullOrEmpty(version) || seen.ContainsKey(id))
            {
                continue;
            }

            string nuspec = Path.Combine(
                PackageRoot, id.ToLowerInvariant(), version, id.ToLowerInvariant() + ".nuspec");
            if (!File.Exists(nuspec))
            {
                Log.LogWarning("Attribution: no .nuspec for {0} {1}; it will be listed as undeclared.", id, version);
                seen[id] = new[] { id, version, "", "", "" };
                continue;
            }

            XElement meta;
            try
            {
                meta = XDocument.Load(nuspec).Root.Elements()
                    .FirstOrDefault(e => e.Name.LocalName == "metadata");
            }
            catch (Exception ex)
            {
                Log.LogWarning("Attribution: cannot read {0}: {1}", nuspec, ex.Message);
                continue;
            }

            if (meta == null)
            {
                continue;
            }

            Func<string, string> field = name =>
            {
                var e = meta.Elements().FirstOrDefault(x => x.Name.LocalName == name);
                return e == null ? "" : e.Value.Trim();
            };

            // A <license type="expression"> is the modern form; licenseUrl is the deprecated one and
            // is often just a redirect stub, so it is only used when it names a real page.
            string licence = "";
            var licenceElement = meta.Elements().FirstOrDefault(x => x.Name.LocalName == "license");
            if (licenceElement != null)
            {
                var type = licenceElement.Attribute("type");
                licence = type != null && type.Value == "file"
                    ? "See " + licenceElement.Value.Trim()
                    : licenceElement.Value.Trim();
            }

            if (licence.Length == 0)
            {
                string url = field("licenseUrl");
                if (url.Length > 0 && url.IndexOf("deprecateLicenseUrl", StringComparison.OrdinalIgnoreCase) < 0)
                {
                    licence = url;
                }
            }

            string project = field("projectUrl");
            if (project.Length == 0)
            {
                project = field("repository");
            }

            seen[id] = new[] { id, version, licence, field("copyright"), project };
        }

        var text = new StringBuilder();
        text.AppendLine("// <auto-generated>");
        text.AppendLine("//     Generated from this project's shipped NuGet packages by build/Attribution.targets.");
        text.AppendLine("//     Do not edit: rebuild instead.");
        text.AppendLine("// </auto-generated>");
        text.AppendLine("#nullable enable");
        text.AppendLine();
        text.AppendLine("using System.Collections.Immutable;");
        text.AppendLine("using Lemmy.Domain.Models;");
        text.AppendLine();
        text.AppendLine("namespace " + Namespace + ";");
        text.AppendLine();
        text.AppendLine("/// <summary>The third-party packages shipped with this head.</summary>");
        text.AppendLine("internal static class GeneratedAttribution");
        text.AppendLine("{");
        text.AppendLine("    /// <summary>One entry per package, ordered by name.</summary>");
        text.AppendLine("    internal static ImmutableArray<PackageAttribution> Packages { get; } =");
        text.AppendLine("    [");
        foreach (var p in seen.Values)
        {
            text.AppendLine("        PackageAttribution.Create("
                + Quote(p[0]) + ", " + Quote(p[1]) + ", " + Quote(p[2]) + ", "
                + Quote(p[3]) + ", " + Quote(p[4]) + "),");
        }

        text.AppendLine("    ];");
        text.AppendLine("}");

        // Only write when the content changed: rewriting would re-trigger compilation every build.
        string generated = text.ToString();
        if (File.Exists(OutputPath) && File.ReadAllText(OutputPath) == generated)
        {
            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.Low, "Attribution: unchanged.");
            return true;
        }

        Directory.CreateDirectory(Path.GetDirectoryName(OutputPath));
        File.WriteAllText(OutputPath, generated);
        Log.LogMessage(
            Microsoft.Build.Framework.MessageImportance.Normal,
            "Attribution: wrote {0} packages to {1}.", seen.Count, OutputPath);
        return true;
    }

    private static string Quote(string value)
    {
        if (value == null)
        {
            return "\"\"";
        }

        // Collapse newlines: copyright fields are occasionally multi-line.
        value = value.Replace("\r", " ").Replace("\n", " ").Trim();
        while (value.Contains("  "))
        {
            value = value.Replace("  ", " ");
        }

        return "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
    }
}
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="WriteAttribution"
          BeforeTargets="BeforeCompile;CoreCompile"
          DependsOnTargets="ResolvePackageAssets"
          Condition="'$(GenerateAttributionData)' == 'true'">

    <PropertyGroup>
      <AttributionFile>$(IntermediateOutputPath)Attribution.g.cs</AttributionFile>
    </PropertyGroup>

    <GenerateAttribution Packages="@(RuntimeCopyLocalItems);@(NativeCopyLocalItems)"
                         PackageRoot="$(NuGetPackageRoot)"
                         OutputPath="$(AttributionFile)"
                         Namespace="$(RootNamespace).Generated" />

    <ItemGroup>
      <Compile Include="$(AttributionFile)" />
      <FileWrites Include="$(AttributionFile)" />
    </ItemGroup>
  </Target>

</Project>
